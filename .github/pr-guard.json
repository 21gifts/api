{
  "schema": "pr-guard/v1",
  "a38": {
    "enforce": ["develop"],
    "exclude": ["main"],
    "default": "enforce"
  },
  "one_review_authors": [
    "davidleomay",
    "TaprootFreak",
    "TaprootFreakAI",
    "Danswar",
    "davidleomayAI",
    "Daniel-DFX",
    "engel120-hub"
  ],
  "workflow_approval": {
    "enabled": true,
    "workflows": [".github/workflows/ci.yaml", ".github/workflows/db-change-notice.yaml"]
  },
  "lifecycle": {
    "enabled": true,
    "auto_ready": true,
    "required_workflows": [".github/workflows/ci.yaml", ".github/workflows/db-change-notice.yaml"],
    "ignored_workflows": [".github/workflows/a38-guard.yml"],
    "required_checks": {
      ".github/workflows/ci.yaml": [
        "Lint",
        "Typecheck, Handbook, E2E-check, Test (100% coverage), Postgres, Build, E2E"
      ],
      ".github/workflows/db-change-notice.yaml": ["Database change notice"]
    }
  }
}
